# CreaClick Agency – configuration Apache (OVH, o2switch, Hostinger…)
# Pour Netlify : voir le fichier _redirects.

RewriteEngine On

# 1. Forcer HTTPS + www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.creaclickagency.com/$1 [L,R=301]

# 2. Redirections 301 des anciennes URL Webador (conservation du référencement)
RewriteRule ^informations-1/?$ /informations/ [L,R=301]
RewriteRule ^equipe/?$ /equipes/ [L,R=301]
RewriteRule ^sponsoring-partenariats/?$ /sponsoring-et-partenariats/ [L,R=301]

# 3. Slash final sur les dossiers (/prestations -> /prestations/)
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*[^/])$ /$1/ [L,R=301]

# Page d'erreur
ErrorDocument 404 /404.html

# Cache navigateur
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# En-têtes de sécurité
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
